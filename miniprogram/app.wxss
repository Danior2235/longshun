/* 龙顺庄园·会议中心 全局样式 */
page {
  background: #f5f6f8;
  font-size: 28rpx;
  color: #333;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC', 'Microsoft YaHei', sans-serif;
}

.container {
  padding: 24rpx;
}

/* 卡片 */
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(31, 58, 95, 0.06);
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f3a5f;
  margin-bottom: 16rpx;
}

/* 按钮 */
.btn-primary {
  background: linear-gradient(135deg, #c9a227, #e0c060);
  color: #1f3a5f;
  font-weight: 600;
  border-radius: 12rpx;
  padding: 20rpx 0;
  text-align: center;
  font-size: 30rpx;
}

.btn-outline {
  border: 2rpx solid #1f3a5f;
  color: #1f3a5f;
  border-radius: 12rpx;
  padding: 18rpx 0;
  text-align: center;
  font-size: 28rpx;
}

.btn-disabled {
  background: #d8d8d8;
  color: #999;
  border-radius: 12rpx;
  padding: 20rpx 0;
  text-align: center;
}

/* 标签 */
.tag {
  display: inline-block;
  font-size: 22rpx;
  color: #1f3a5f;
  background: #eef2f8;
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
  margin-right: 12rpx;
  margin-bottom: 8rpx;
}

.tag-gold {
  color: #8a6d1a;
  background: #f7f0dc;
}

.tag-green {
  color: #1d7a4f;
  background: #e5f5ec;
}

/* 表单 */
.form-item {
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.form-input {
  background: #f5f6f8;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  font-size: 28rpx;
  border: 2rpx solid #e4e7ec;
}

/* 价格 */
.price {
  color: #c0392b;
  font-weight: 700;
}

.price-gold {
  color: #c9a227;
  font-weight: 700;
}

/* 空态 */
.empty {
  text-align: center;
  color: #999;
  padding: 80rpx 0;
}

.row {
  display: flex;
  align-items: center;
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
