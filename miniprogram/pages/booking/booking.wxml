<view class="page">
  <view class="card">
    <view class="card-title">预订信息</view>

    <view class="form-item">
      <text class="form-label">预订类型</text>
      <radio-group class="row" bindchange="onTypeChange">
        <label class="radio-item"><radio value="room" checked="{{type === 'room'}}" color="#1f3a5f" />客房</label>
        <label class="radio-item"><radio value="venue" checked="{{type === 'venue'}}" color="#1f3a5f" />会场</label>
      </radio-group>
    </view>

    <view class="form-item">
      <text class="form-label">{{type === 'room' ? '房型（如：庭院小院大床房·含早）' : '会场名称'}}</text>
      <input class="form-input" value="{{item}}" data-key="item" bindinput="onInput" placeholder="选择后自动带出" />
    </view>

    <view class="form-item">
      <text class="form-label">姓名 *</text>
      <input class="form-input" value="{{customer}}" data-key="customer" bindinput="onInput" placeholder="联系人姓名" />
    </view>

    <view class="form-item">
      <text class="form-label">手机号 *</text>
      <input class="form-input" type="number" value="{{phone}}" data-key="phone" bindinput="onInput" placeholder="联系手机" />
    </view>

    <view class="form-item">
      <text class="form-label">开始日期</text>
      <picker mode="date" value="{{date}}" start="{{date}}" bindchange="onDateChange">
        <view class="form-input picker-value">{{date}}</view>
      </picker>
    </view>

    <view class="form-item">
      <text class="form-label">结束日期</text>
      <picker mode="date" value="{{dateEnd}}" start="{{date}}" bindchange="onDateEndChange">
        <view class="form-input picker-value">{{dateEnd}}</view>
      </picker>
    </view>

    <view class="form-item">
      <text class="form-label">使用天数</text>
      <view class="form-input picker-value">{{days}} 天</view>
    </view>

    <view class="form-item" wx:if="{{type === 'venue'}}">
      <text class="form-label">场次</text>
      <radio-group class="row" bindchange="onSessionChange">
        <label class="radio-item"><radio value="half" checked="{{session === 'half'}}" color="#1f3a5f" />半天</label>
        <label class="radio-item"><radio value="full" checked="{{session === 'full'}}" color="#1f3a5f" />全天</label>
      </radio-group>
    </view>

    <view class="form-item">
      <text class="form-label">金额（元）*</text>
      <input class="form-input" type="digit" value="{{amount}}" data-key="amount" bindinput="onInput" placeholder="预估价，可在报价页自动带出" />
    </view>

    <view class="form-item">
      <text class="form-label">备注</text>
      <textarea class="form-input note-input" value="{{remark}}" data-key="remark" bindinput="onInput" placeholder="如：含早、桌数、设备要求等" />
    </view>
  </view>

  <view class="submit-wrap">
    <view class="btn-primary {{submitting ? 'btn-disabled' : ''}}" bindtap="onSubmit">
      {{submitting ? '提交中…' : '提交预订'}}
    </view>
  </view>
</view>
