.page {
  padding: 24rpx;
}

.hero {
  background: linear-gradient(135deg, #1f3a5f 0%, #2c5587 60%, #c9a227 130%);
  border-radius: 20rpx;
  padding: 56rpx 40rpx;
  color: #fff;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(31, 58, 95, 0.25);
}

.hero-title {
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.hero-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  opacity: 0.85;
  letter-spacing: 1rpx;
}

.notice {
  border-left: 8rpx solid #c9a227;
}

.notice-text {
  font-size: 26rpx;
  color: #555;
  line-height: 1.7;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.feature {
  width: 48%;
  box-sizing: border-box;
  text-align: center;
  padding: 36rpx 20rpx;
}

.feature:active {
  transform: scale(0.97);
}

.feature-icon {
  font-size: 64rpx;
}

.feature-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f3a5f;
  margin: 14rpx 0 8rpx;
}

.feature-desc {
  font-size: 22rpx;
  color: #888;
  line-height: 1.5;
}

.footer {
  text-align: center;
  color: #aaa;
  font-size: 24rpx;
  padding: 30rpx 0 40rpx;
}
