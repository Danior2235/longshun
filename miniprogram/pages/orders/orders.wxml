<view class="page">
  <view
    class="card order-card"
    wx:for="{{list}}"
    wx:key="id"
    data-item="{{item}}"
    bindtap="goPay"
  >
    <view class="row-between">
      <text class="order-id">单号 {{item.id}}</text>
      <text class="status {{item.status === 'paid' ? 'status-paid' : ''}}">{{item.statusText}}</text>
    </view>
    <view class="order-row">
      <text class="order-label">项目</text>
      <text class="order-value">{{item.itemText}}</text>
    </view>
    <view class="order-row">
      <text class="order-label">客户</text>
      <text class="order-value">{{item.customer}}{{item.phone ? ' · ' + item.phone : ''}}</text>
    </view>
    <view class="order-row" wx:if="{{item.date}}">
      <text class="order-label">日期</text>
      <text class="order-value">{{item.date}}</text>
    </view>
    <view class="row-between order-bottom">
      <text class="order-amount">金额 {{item.amountText}}</text>
      <text wx:if="{{item.status !== 'paid'}}" class="pay-link">去支付 ›</text>
    </view>
  </view>

  <view wx:if="{{!loading && list.length === 0}}" class="empty">
    暂无订单，去首页看看吧
  </view>
</view>
