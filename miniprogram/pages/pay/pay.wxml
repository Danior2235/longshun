<view class="page">
  <view class="card pay-head">
    <view class="pay-amount">
      <text class="amount-label">应付金额</text>
      <view class="amount">¥{{amount}}</view>
    </view>
    <view class="row-between order-line">
      <text class="order-label">订单号</text>
      <text class="order-value">{{orderId}}</text>
    </view>
    <view class="row-between order-line">
      <text class="order-label">支付状态</text>
      <text class="status {{status === 'paid' ? 'status-paid' : ''}}">{{statusText}}</text>
    </view>
  </view>

  <view class="card" wx:if="{{status !== 'paid'}}">
    <view class="card-title">选择支付方式</view>
    <view class="pay-method" bindtap="onMockPay">
      <view class="method-icon">🧪</view>
      <view class="method-info">
        <view class="method-name">模拟支付（开发调试）</view>
        <view class="method-desc">调用服务端 /api/pay/mock 完成支付</view>
      </view>
    </view>
    <view class="pay-method" bindtap="onWechatPay">
      <view class="method-icon wechat-icon">💬</view>
      <view class="method-info">
        <view class="method-name">微信支付</view>
        <view class="method-desc">调用 wx.requestPayment（需真实支付参数）</view>
      </view>
    </view>
  </view>

  <view class="card" wx:if="{{status === 'paid'}}">
    <view class="paid-box">
      <view class="paid-icon">✔</view>
      <view class="paid-title">支付成功</view>
      <view class="btn-primary go-btn" bindtap="goOrders">查看订单</view>
    </view>
  </view>

  <view class="row-between query-bar">
    <view class="btn-outline query-btn" bindtap="onQueryStatus">刷新支付状态</view>
    <view class="btn-outline query-btn" bindtap="goOrders">查看我的订单</view>
  </view>
</view>
