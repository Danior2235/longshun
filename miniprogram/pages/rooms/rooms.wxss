.page {
  padding: 24rpx;
}

.search-bar {
  background: #fff;
  border-radius: 16rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(31, 58, 95, 0.06);
}

.search-input {
  font-size: 28rpx;
}

.placeholder {
  color: #bbb;
}

.summary-text {
  font-size: 24rpx;
  color: #888;
}

.room-item {
  padding: 20rpx 0;
  border-top: 2rpx solid #f0f1f4;
}

.room-item:first-of-type {
  border-top: none;
}

.room-head {
  display: flex;
  align-items: center;
}

.room-type {
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
  margin-right: 14rpx;
}

.price-big {
  font-size: 36rpx;
}

.room-meta {
  margin-top: 12rpx;
}

.book-btn {
  margin-top: 16rpx;
  background: linear-gradient(135deg, #c9a227, #e0c060);
  color: #1f3a5f;
  font-weight: 600;
  font-size: 26rpx;
  text-align: center;
  padding: 12rpx 0;
  border-radius: 10rpx;
}
