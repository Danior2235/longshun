.page {
  padding: 24rpx;
}

.search-bar {
  background: #fff;
  border-radius: 16rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(31, 58, 95, 0.06);
}

.search-input {
  font-size: 28rpx;
}

.placeholder {
  color: #bbb;
}

.summary-text {
  font-size: 24rpx;
  color: #888;
}

.venue-item {
  padding: 20rpx 0;
  border-top: 2rpx solid #f0f1f4;
}

.venue-item:first-of-type {
  border-top: none;
}

.venue-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
}

.venue-cap {
  font-size: 24rpx;
  color: #888;
}

.venue-price {
  font-size: 30rpx;
  margin: 10rpx 0;
}

.venue-row {
  display: flex;
  margin-top: 6rpx;
}

.venue-label {
  width: 90rpx;
  color: #999;
  font-size: 24rpx;
}

.venue-value {
  color: #555;
  font-size: 24rpx;
}

.tags {
  margin-top: 12rpx;
}

.note {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #999;
  line-height: 1.5;
}

.book-btn {
  margin-top: 16rpx;
  background: linear-gradient(135deg, #1f3a5f, #2c5587);
  color: #fff;
  font-weight: 600;
  font-size: 26rpx;
  text-align: center;
  padding: 12rpx 0;
  border-radius: 10rpx;
}
